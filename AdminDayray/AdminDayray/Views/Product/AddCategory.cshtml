@model AdminDayray.Migrations.Category

@{
    ViewData["Title"] = "Добавить категорию";
}

<div class="container mt-5">
    <h2 class="text-center mb-4 text-primary">Добавить категорию</h2>

    <form asp-action="AddCategory">

        <div class="form-group">
            <label for="Name">Название</label>
            <input type="text" class="form-control" id="Name" name="Name" required />
        </div>
        <div class="form-group">
            <label for="Map">Карта</label>
            <input type="text" class="form-control" id="Map" name="Map" />
        </div>
        <button type="submit" class="btn btn-success mt-3">Сохранить</button>
    </form>
</div>
