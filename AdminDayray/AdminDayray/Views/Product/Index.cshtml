@model IEnumerable<AdminDayray.Migrations.Category>

@{
    ViewData["Title"] = "Категории";
}

<div class="container mt-5">
    <h2 class="text-center mb-4 text-primary">Категории</h2>

    <div class="text-end mb-4">
        <!-- Кнопка добавления категории -->
        <a asp-action="AddCategory" class="btn btn-primary">Добавить категорию</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover align-middle shadow-sm rounded">
            <thead class="bg-primary text-white">
            <tr>
                <th>Название</th>
                <th>Карта</th>
                <th class="text-center">Действия</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>
                        @if (!string.IsNullOrEmpty(category.Map))
                        {
                            string imagePath = category.Map.Replace("../static/static/", "/static/");
                            <img src="@imagePath" alt="Фото продукта" style="max-width: 100px; max-height: 100px; object-fit: cover;" />
                        }
                        else
                        {
                            <span class="text-muted">Нет фото</span>
                        }
                        </td>
                    <td class="text-center">
                        <div class="btn-group" role="group">
                            <a asp-action="EditCategory" asp-route-id="@category.CategoryId" class="btn btn-outline-warning">Редактировать</a>
                            <a asp-action="ViewProducts" asp-route-id="@category.CategoryId" class="btn btn-outline-info">Просмотреть продукты</a>
                            <a asp-action="DeleteCategory" asp-route-id="@category.CategoryId" class="btn btn-outline-danger" onclick="return confirm('Вы уверены, что хотите удалить эту категорию?');">Удалить</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
