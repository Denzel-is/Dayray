@model AdminDayray.Migrations.Category

@{
    ViewData["Title"] = "Продукты категории";
}

<div class="container mt-5">
    <h2 class="text-center mb-4 text-primary">Продукты категории: @Model.Name</h2>

    <div class="text-end mb-4">
        <a asp-action="Index" class="btn btn-secondary">Назад к категориям</a>
        <a asp-action="AddProduct" asp-route-categoryId="@Model.CategoryId" class="btn btn-primary">Добавить продукт</a>
    </div>

    @if (Model.Products != null && Model.Products.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover align-middle shadow-sm rounded">
                <thead class="bg-primary text-white">
                <tr>
                    <th>Фото</th>
                    <th>Название</th>
                    <th>Описание</th>
                    <th>Цена</th>
                    <th>Количество на складе</th>
                    <th class="text-center">Действия</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(product.MapP))
                            {
                                string imagePath = product.MapP.Replace("../static/static/", "/static/");
                                <img src="@imagePath" alt="Фото продукта" style="max-width: 100px; max-height: 100px; object-fit: cover;" />
                            }
                            else
                            {
                                <span class="text-muted">Нет фото</span>
                            }
                        </td>
                        <td>@product.Name</td>
                        <td>@product.Description</td>
                        <td>@product.Price</td>
                        <td>@product.StockQuantity</td>
                        <td class="text-center">
                            <a asp-action="EditProduct" asp-route-id="@product.ProductId" class="btn btn-outline-warning">Редактировать</a>
                            <a asp-action="DeleteProduct" asp-route-id="@product.ProductId" class="btn btn-outline-danger" onclick="return confirm('Вы уверены, что хотите удалить этот продукт?');">Удалить</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-center text-muted">В этой категории нет продуктов.</p>
    }
</div>
