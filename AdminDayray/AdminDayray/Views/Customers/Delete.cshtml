@model AdminDayray.Migrations.Reg

@{
    ViewData["Title"] = "Удалить клиента";
}

<div class="container mt-5">
    <h2 class="text-center mb-4 text-danger">Удалить клиента</h2>

    <p>Вы уверены, что хотите удалить клиента: <strong>@Model.FirstName</strong>?</p>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" name="id" value="@Model.CustomerId" />
        <button type="submit" class="btn btn-danger">Удалить</button>
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>