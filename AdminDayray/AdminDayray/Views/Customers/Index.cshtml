@model IEnumerable<AdminDayray.Migrations.Reg>

@{
    ViewData["Title"] = "Список клиентов";
}

<div class="container mt-5">
    <h2 class="text-center mb-4 text-primary">Список клиентов</h2>
    <a asp-action="Create" class="btn btn-primary mb-3">Добавить клиента</a>

    <table class="table table-bordered">
        <thead>
        <tr>
            <th>#</th>
            <th>Имя</th>
            <th>Email</th>
            <th>Город</th>
            <th>Действия</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.CustomerId</td>
                <td>@customer.FirstName</td>
                <td>@customer.Email</td>
                <td>@customer.City</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@customer.CustomerId" class="btn btn-warning btn-sm">Редактировать</a>
                    <a asp-action="Delete" asp-route-id="@customer.CustomerId" class="btn btn-danger btn-sm">Удалить</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>